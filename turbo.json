{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml", "tsconfig.json"],
  "tasks": {
    "delivery.build": {
      "inputs": ["src/**", "tsdown.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"],
      "dependsOn": ["^delivery.build"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "sourceQuality.staticAnalysis": {
      "inputs": ["src/**", "eslint.config.ts", "eslint.config.js"],
      "outputs": []
    },
    "verification.unitTests": {
      "inputs": ["src/**", "vitest.config.ts", "package.json"],
      "outputs": ["test-report.junit.xml"],
      "dependsOn": ["delivery.build", "^delivery.build"]
    },
    "test:coverage": {
      "inputs": ["src/**", "vitest.config.ts", "package.json"],
      "outputs": ["coverage/**"],
      "dependsOn": ["delivery.build"]
    },
    "verification.typeSafety": {
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": [],
      "dependsOn": ["^delivery.build"]
    }
  }
}
