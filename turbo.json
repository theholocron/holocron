{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml", "tsconfig.json", "holocron.config.*", "astromech.config.*"],
  "tasks": {
    "sourceQuality.staticAnalysis": {
      "inputs": [
        "src/**",
        "eslint.config.ts",
        "eslint.config.js",
        "eslint.config.mjs",
        "eslint.config.cjs",
        "$TURBO_ROOT$/eslint.config.ts",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/eslint.config.cjs"
      ],
      "outputs": [],
      "dependsOn": ["^delivery.build", "@theholocron/eslint-config#delivery.build"]
    },
    "verification.unitTests": {
      "inputs": [
        "src/**",
        "test/**",
        "vitest.config.ts",
        "vitest.config.js",
        "vitest.config.mjs",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/vitest.config.js",
        "$TURBO_ROOT$/vitest.config.mjs",
        "package.json"
      ],
      "outputs": ["test-report.junit.xml", "coverage/**"],
      "dependsOn": ["delivery.build", "^delivery.build"]
    },
    "verification.typeSafety": {
      "inputs": ["src/**", "test/**", "tsconfig.json"],
      "outputs": [],
      "dependsOn": ["^delivery.build"]
    },
    "delivery.build": {
      "inputs": [
        "src/**",
        "package.json",
        "tsdown.config.ts",
        "$TURBO_ROOT$/tsdown.config.ts",
        "vite.config.ts",
        "rollup.config.ts",
        "tsconfig.json"
      ],
      "outputs": ["dist/**"],
      "dependsOn": ["^delivery.build"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    }
  }
}
