{
  "name": "@theholocron/astro-config",
  "version": "8.4.4",
  "description": "Astro configuration factory for theholocron docs sites.",
  "keywords": [
    "astro",
    "config",
    "docs",
    "starlight",
    "theholocron"
  ],
  "homepage": "https://github.com/theholocron/configs/tree/main/packages/astro-config#readme",
  "bugs": "https://github.com/theholocron/configs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/configs.git"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "delivery.build": "tsdown",
    "sourceQuality.staticAnalysis": "holocron run sourceQuality.staticAnalysis --",
    "test:watch": "vitest",
    "verification.typeSafety": "holocron run verification.typeSafety --",
    "verification.unitTests": "holocron run verification.unitTests --"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/starlight": "^0.41.7",
    "@theholocron/cli": "catalog:holocron",
    "@theholocron/docs-theme": "^1.3.5",
    "@theholocron/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "astro": "^7.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@astrojs/react": ">=6.0.0",
    "astro": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "releases": "https://github.com/theholocron/configs/releases",
  "wiki": "https://github.com/theholocron/configs/wiki"
}
