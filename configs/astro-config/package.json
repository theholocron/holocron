{
  "name": "@theholocron/astro-config",
  "version": "8.8.2",
  "description": "Astro configuration factory for theholocron docs sites.",
  "keywords": [
    "astro",
    "config",
    "docs",
    "starlight",
    "theholocron"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/configs/astro-config/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "configs/astro-config"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "delivery.build": "tsdown",
    "sourceQuality.staticAnalysis": "eslint .",
    "test:watch": "vitest",
    "verification.typeSafety": "tsc --noEmit",
    "verification.unitTests": "vitest run"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/starlight": "^0.41.7",
    "@theholocron/docs-theme": "^1.3.5",
    "@theholocron/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "astro": "^7.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@astrojs/react": ">=6.0.0",
    "astro": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
