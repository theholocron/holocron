{
  "name": "@theholocron/astro-config",
  "version": "7.27.0",
  "description": "Astro configuration factory for theholocron docs sites.",
  "keywords": [
    "astro",
    "config",
    "docs",
    "starlight",
    "theholocron"
  ],
  "homepage": "https://github.com/theholocron/configs/tree/main/packages/astro-config#readme",
  "bugs": "https://github.com/theholocron/configs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/configs.git"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@theholocron/docs-theme": "^1.3.5",
    "@theholocron/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "astro": "^7.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "releases": "https://github.com/theholocron/configs/releases",
  "wiki": "https://github.com/theholocron/configs/wiki"
}
