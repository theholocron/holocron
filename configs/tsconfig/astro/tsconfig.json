{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Astro (ESM, bundler)",

  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  }
}
