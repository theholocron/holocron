{
  "name": "@theholocron/semantic-release-config",
  "version": "8.8.2",
  "description": "A semantic-release configuration for automated versioning and publishing.",
  "keywords": [
    "semantic-release",
    "release",
    "versioning",
    "changelog",
    "config",
    "theholocron"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/configs/semantic-release-config/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "configs/semantic-release-config"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "delivery.build": "tsdown",
    "sourceQuality.staticAnalysis": "eslint .",
    "test:watch": "vitest",
    "verification.typeSafety": "tsc --noEmit",
    "verification.unitTests": "vitest run"
  },
  "devDependencies": {
    "@theholocron/tsconfig": "workspace:*",
    "@theholocron/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@semantic-release/changelog": "^6",
    "@semantic-release/commit-analyzer": "^13",
    "@semantic-release/exec": "^7",
    "@semantic-release/git": "^10",
    "@semantic-release/github": "^11 || ^12",
    "@semantic-release/release-notes-generator": "^14",
    "conventional-changelog-conventionalcommits": "^10",
    "semantic-release": "^24 || ^25"
  },
  "peerDependenciesMeta": {
    "@semantic-release/exec": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
