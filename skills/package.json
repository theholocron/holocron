{
  "name": "@theholocron/skills",
  "version": "1.4.3",
  "description": "Shared agent skill registry.",
  "homepage": "https://github.com/theholocron/skills#readme",
  "bugs": "https://github.com/theholocron/skills/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/skills.git"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./skills/*": "./src/*"
  },
  "files": [
    "src/",
    "skills-lock.json",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @theholocron/skills-site build",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-report.junit.xml test/index.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-report.junit.xml test/index.mjs"
  },
  "devDependencies": {
    "@astrojs/starlight": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@theholocron/astro-config": "catalog:configs",
    "@theholocron/cli": "catalog:holocron",
    "@theholocron/commitlint-config": "catalog:configs",
    "@theholocron/docs-theme": "catalog:",
    "@theholocron/prettier-config": "catalog:configs",
    "@theholocron/semantic-release-config": "catalog:configs",
    "@theholocron/tsconfig": "catalog:configs",
    "@theholocron/holocron-plugin-github": "catalog:holocron",
    "astro": "catalog:",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "@theholocron/components-doc": "^1.2.0",
    "@theholocron/registry-doc": "^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "releases": "https://github.com/theholocron/skills/releases",
  "wiki": "https://github.com/theholocron/skills/wiki"
}
