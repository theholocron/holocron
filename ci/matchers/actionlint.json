{
  "problemMatcher": [
    {
      "owner": "actionlint",
      "pattern": [
        {
          "regexp": "^(?:\\S+:\\S+:\\s)?(\\.github\\/[^:]+):(\\d+):(\\d+):\\s(.*)\\s\\[(.+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
