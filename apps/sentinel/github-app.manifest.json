{
  "description": "Holocron's minimal GitHub App — validates holocron.config.ts, syncs capability status to repo properties, and posts a compliance check run on every push to the default branch and pull request.",
  "url": "https://github.com/theholocron/holocron/tree/main/apps/sentinel#readme",
  "public": false,
  "default_permissions": {
    "checks": "write",
    "contents": "write",
    "issues": "write",
    "members": "read",
    "metadata": "read",
    "organization_projects": "write",
    "pull_requests": "write",
    "repository_custom_properties": "write",
    "statuses": "read"
  },
  "default_events": [
    "check_run",
    "issues",
    "membership",
    "organization",
    "pull_request",
    "pull_request_review",
    "push",
    "status"
  ]
}
