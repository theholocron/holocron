{
  "name": "@theholocron/sentinel",
  "version": "0.0.0",
  "private": true,
  "description": "Holocron's minimal GitHub App — webhook receiver, default-branch-only holocron.config.ts validation, custom-properties sync, capability-compliance and commit-standards check runs.",
  "keywords": [
    "github-app",
    "holocron",
    "sentinel",
    "theholocron",
    "webhook"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/sentinel/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "apps/sentinel"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "delivery.build": "tsdown",
    "delivery.deploy": "pnpm run delivery.build && node scripts/stage-deploy.mjs && holocron deploy --files .vercel-deploy --project-id sentinel --target production",
    "delivery.previewDeploy": "pnpm run delivery.build && node scripts/stage-deploy.mjs && holocron deploy --files .vercel-deploy --project-id sentinel",
    "sourceQuality.staticAnalysis": "eslint .",
    "test:watch": "vitest",
    "verification.typeSafety": "tsc --noEmit",
    "verification.unitTests": "vitest run"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "@theholocron/astromech": "workspace:*",
    "@theholocron/cli": "workspace:*",
    "@theholocron/commitlint-config": "workspace:^",
    "@theholocron/datapad": "workspace:*",
    "@theholocron/env-utils": "workspace:^",
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/fs-utils": "workspace:^",
    "@theholocron/git-utils": "workspace:^",
    "@theholocron/github-client": "workspace:^",
    "@theholocron/holocron-config": "catalog:apps",
    "@theholocron/http-client": "workspace:^",
    "@theholocron/json-utils": "workspace:^",
    "@theholocron/markdownlint-config": "workspace:^",
    "@theholocron/misc-utils": "workspace:^",
    "@theholocron/object-utils": "workspace:^",
    "@theholocron/observability": "workspace:^",
    "@theholocron/pkg-utils": "workspace:^",
    "@theholocron/prettier-config": "workspace:^",
    "@tktco/node-actionlint": "catalog:apps",
    "@vitest/eslint-plugin": "catalog:",
    "@vscode-shellcheck/shellcheck-wasm": "catalog:apps",
    "alex": "catalog:apps",
    "dotenv": "catalog:",
    "editorconfig": "catalog:apps",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "markdownlint": "catalog:apps",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "yaml": "catalog:apps"
  },
  "devDependencies": {
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
