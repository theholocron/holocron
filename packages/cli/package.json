{
  "name": "@theholocron/cli",
  "version": "3.48.0",
  "description": "The Holocron CLI — a pluggable, capability-based orchestrator for spinning up and operating software projects.",
  "keywords": [
    "cli",
    "devops",
    "dx",
    "holocron",
    "orchestrator",
    "theholocron"
  ],
  "homepage": "https://github.com/theholocron/holocron/tree/main/packages/cli#readme",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./capabilities": {
      "types": "./src/plugin/capabilities.ts",
      "import": "./dist/plugin/capabilities.mjs",
      "default": "./dist/plugin/capabilities.mjs"
    }
  },
  "bin": {
    "holocron": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "start": "tsx ./src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "catalog:",
    "@napi-rs/keyring": "^1.3.0",
    "@sentry/node": "catalog:",
    "@theholocron/components-doc": "^1.6.0",
    "@theholocron/env-utils": "catalog:utils",
    "@theholocron/github-client": "catalog:clients",
    "@theholocron/http-client": "catalog:clients",
    "@theholocron/registry-doc": "^1.8.0",
    "chalk": "catalog:",
    "ora": "catalog:",
    "tsx": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/rollup-plugin-transform-template": "workspace:*",
    "@theholocron/tsconfig": "catalog:configs",
    "@theholocron/vitest-config": "catalog:configs",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./capabilities": {
        "types": "./dist/plugin/capabilities.d.mts",
        "import": "./dist/plugin/capabilities.mjs",
        "default": "./dist/plugin/capabilities.mjs"
      }
    }
  }
}
