# --config <resolved shared path> (config-resolution workstream, #676) — falls
# back to commitlint's own auto-discovery of a local commitlint.config.ts when
# the shared package's built dist/ isn't present (not installed, or a stale
# install predating this file).
COMMITLINT_CONFIG="node_modules/@theholocron/commitlint-config/dist/index.js"
if [ -f "$COMMITLINT_CONFIG" ]; then
	npx --no -- commitlint --config "$COMMITLINT_CONFIG" --edit "$1"
else
	npx --no -- commitlint --edit "$1"
fi
