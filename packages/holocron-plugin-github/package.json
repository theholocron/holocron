{
  "name": "@theholocron/holocron-plugin-github",
  "version": "2.0.0-alpha.18",
  "description": "Holocron plugin for GitHub. Implements source, ci, secrets, environments, and issues capabilities against the GitHub REST API.",
  "homepage": "https://github.com/theholocron/holocron/tree/main/packages/holocron-plugin-github#readme",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "packages/holocron-plugin-github"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "tsx scripts/validate.mjs"
  },
  "peerDependencies": {
    "@theholocron/cli": "workspace:*"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/eslint-config": "catalog:",
    "@theholocron/tsconfig": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/libsodium-wrappers": "^0.7.14",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
