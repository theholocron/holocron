{
  "name": "@theholocron/holocron",
  "version": "5.0.0-alpha.285",
  "private": true,
  "description": "A pluggable, capability-based CLI for spinning up and operating software projects — your own infrastructure-as-tool.",
  "keywords": [
    "automation",
    "cli",
    "developer-tools",
    "holocron",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": "github:theholocron/holocron",
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "turbo run delivery.build",
    "deps": "node cli/cli/dist/cli.mjs probe deps report",
    "deps:check": "node cli/cli/dist/cli.mjs probe deps check",
    "format": "prettier --write .",
    "holocron": "node cli/cli/dist/cli.mjs",
    "lint": "turbo run sourceQuality.staticAnalysis",
    "prepare": "husky",
    "test": "turbo run verification.unitTests -- --coverage",
    "typecheck": "turbo run verification.typeSafety"
  },
  "devDependencies": {
    "@astrojs/react": "catalog:",
