{
  "name": "@theholocron/holocron",
  "version": "3.5.4",
  "private": true,
  "description": "A pluggable, capability-based CLI for spinning up and operating software projects — your own infrastructure-as-tool.",
  "homepage": "https://docs.theholocron.dev/holocron/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "audit": "knip",
    "build": "turbo run build",
    "format": "prettier --write .",
    "holocron": "tsx packages/cli/src/cli.ts",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/types": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@theholocron/cli": "workspace:*",
    "@theholocron/commitlint-config": "catalog:configs",
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/holocron-config": "catalog:configs",
    "@theholocron/holocron-plugin-1password": "workspace:*",
    "@theholocron/holocron-plugin-clerk": "workspace:*",
    "@theholocron/holocron-plugin-doppler": "workspace:*",
    "@theholocron/holocron-plugin-github": "workspace:*",
    "@theholocron/holocron-plugin-infisical": "workspace:*",
    "@theholocron/holocron-plugin-neon": "workspace:*",
    "@theholocron/holocron-plugin-postman": "workspace:*",
    "@theholocron/holocron-plugin-vercel": "workspace:*",
    "@theholocron/lint-staged-config": "catalog:configs",
    "@theholocron/prettier-config": "catalog:configs",
    "@theholocron/semantic-release-config": "catalog:configs",
    "@theholocron/skills": "^1.2.1",
    "@theholocron/tsconfig": "catalog:configs",
    "@vitest/eslint-plugin": "catalog:",
    "alexjs": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.14",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
