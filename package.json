{
  "name": "@theholocron/holocron-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Holocron CLI and its plugins.",
  "homepage": "https://github.com/theholocron/holocron#readme",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "lint": "pnpm -r --filter './packages/*' lint",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "test:coverage": "pnpm -r --filter './packages/*' test:coverage",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@theholocron/commitlint-config": "^3.5.1",
    "@theholocron/eslint-config": "^3.5.1",
    "@theholocron/lint-staged-config": "^3.5.1",
    "@theholocron/prettier-config": "^3.5.1",
    "@theholocron/tsconfig": "^3.4.4",
    "@tsconfig/node-lts": "^22.0.2",
    "alexjs": "^1.0.0",
    "marked-man": "^2.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
