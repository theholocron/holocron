{
  "name": "@theholocron/holocron",
  "version": "5.0.0-alpha.66",
  "private": true,
  "description": "A pluggable, capability-based CLI for spinning up and operating software projects — your own infrastructure-as-tool.",
  "keywords": [
    "automation",
    "cli",
    "developer-tools",
    "holocron",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": "github:theholocron/holocron",
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "turbo run delivery.build",
    "format": "prettier --write .",
    "holocron": "node packages/cli/dist/cli.mjs",
    "lint": "holocron run sourceQuality.staticAnalysis --",
    "prepare": "husky",
    "test": "holocron run verification.unitTests --",
    "typecheck": "holocron run verification.typeSafety --"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "^0.41.7",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@theholocron/astro-config": "catalog:configs",
    "@theholocron/astromech": "workspace:*",
    "@theholocron/cli": "workspace:*",
    "@theholocron/commitlint-config": "catalog:configs",
    "@theholocron/components-doc": "^1.2.0",
    "@theholocron/devmoji-config": "catalog:configs",
    "@theholocron/docs-theme": "catalog:configs",
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/holocron-config": "catalog:configs",
    "@theholocron/holocron-plugin-1password": "workspace:*",
    "@theholocron/holocron-plugin-axiom": "workspace:*",
    "@theholocron/holocron-plugin-clerk": "workspace:*",
    "@theholocron/holocron-plugin-cloudflare": "workspace:*",
    "@theholocron/holocron-plugin-discord": "workspace:*",
    "@theholocron/holocron-plugin-doppler": "workspace:*",
    "@theholocron/holocron-plugin-fern": "workspace:*",
    "@theholocron/holocron-plugin-github": "workspace:*",
    "@theholocron/holocron-plugin-infisical": "workspace:*",
    "@theholocron/holocron-plugin-neon": "workspace:*",
    "@theholocron/holocron-plugin-posthog": "workspace:*",
    "@theholocron/holocron-plugin-postman": "workspace:*",
    "@theholocron/holocron-plugin-sentry": "workspace:*",
    "@theholocron/holocron-plugin-slack": "workspace:*",
    "@theholocron/holocron-plugin-vercel": "workspace:*",
    "@theholocron/lint-staged-config": "catalog:configs",
    "@theholocron/prettier-config": "catalog:configs",
    "@theholocron/registry-doc": "^1.14.0",
    "@theholocron/semantic-release-config": "catalog:configs",
    "@theholocron/skills": "^1.3.3",
    "@theholocron/tsconfig": "catalog:configs",
    "@vitest/eslint-plugin": "catalog:",
    "alexjs": "^1.0.0",
    "astro": "^7.2.10",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^2.0.1",
      "tsx": "4.22.4"
    }
  }
}
