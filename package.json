{
  "name": "@theholocron/holocron",
  "version": "5.0.0-alpha.498",
  "private": true,
  "description": "A pluggable, capability-based CLI for spinning up and operating software projects — your own infrastructure-as-tool.",
  "keywords": [
    "automation",
    "cli",
    "developer-tools",
    "holocron",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": "github:theholocron/holocron",
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "deps": "node cli/cli/dist/cli.mjs probe deps report",
    "deps:check": "node cli/cli/dist/cli.mjs probe deps check",
    "format": "prettier --write .",
    "holocron": "node cli/cli/dist/cli.mjs",
    "lint": "turbo run lint",
    "lint:code": "turbo run lint:code",
    "lint:data": "yamllint .",
    "lint:editorconfig": "editorconfig-checker",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:unused": "knip",
    "prepare": "husky",
    "scan": "turbo run scan",
    "scan:secrets": "gitleaks dir --no-banner --config .gitleaks.toml",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/starlight": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/git": "catalog:",
    "@theholocron/astro-config": "link:./configs/astro-config",
    "@theholocron/astromech": "link:./cli/astromech",
    "@theholocron/cli": "link:./cli/cli",
    "@theholocron/commitlint-config": "link:./configs/commitlint-config",
    "@theholocron/devmoji-config": "link:./configs/devmoji-config",
    "@theholocron/docs-theme": "link:./themes/docs-theme",
    "@theholocron/eslint-config": "link:./configs/eslint-config",
    "@theholocron/holocron-plugin-1password": "link:./plugins/holocron-plugin-1password",
    "@theholocron/holocron-plugin-axiom": "link:./plugins/holocron-plugin-axiom",
    "@theholocron/holocron-plugin-bruno": "link:./plugins/holocron-plugin-bruno",
