{
  "name": "@theholocron/holocron",
  "version": "2.0.0-alpha.73",
  "private": true,
  "description": "A pluggable, capability-based CLI for spinning up and operating software projects — your own infrastructure-as-tool.",
  "homepage": "https://github.com/theholocron/holocron#readme",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "format": "prettier --write .",
    "holocron": "tsx packages/cli/src/cli.ts",
    "audit": "knip",
    "lint": "pnpm -r --filter './packages/*' lint",
    "test": "pnpm -r --filter './packages/*' test",
    "test:coverage": "pnpm -r --filter './packages/*' test:coverage",
    "typecheck": "pnpm -r --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@commitlint/types": "^19.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@theholocron/cli": "workspace:*",
    "@theholocron/commitlint-config": "catalog:",
    "@theholocron/eslint-config": "catalog:",
    "@theholocron/holocron-config": "catalog:",
    "@theholocron/holocron-plugin-1password": "workspace:*",
    "@theholocron/holocron-plugin-clerk": "workspace:*",
    "@theholocron/holocron-plugin-doppler": "workspace:*",
    "@theholocron/holocron-plugin-github": "workspace:*",
    "@theholocron/holocron-plugin-infisical": "workspace:*",
    "@theholocron/holocron-plugin-neon": "workspace:*",
    "@theholocron/holocron-plugin-postman": "workspace:*",
    "@theholocron/holocron-plugin-vercel": "workspace:*",
    "@theholocron/lint-staged-config": "catalog:",
    "@theholocron/prettier-config": "catalog:",
    "@theholocron/semantic-release-config": "catalog:",
    "@theholocron/skills": "^1.0.0",
    "@theholocron/tsconfig": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "alexjs": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^10.2.0",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.3",
    "semantic-release": "^25.0.5",
    "tsdown": "^0.22.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
