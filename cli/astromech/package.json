{
  "name": "@theholocron/astromech",
  "version": "5.0.0-alpha.248",
  "description": "The Holocron task runner — one task manifest drives `holocron run`, `holocron run ci`, the CI workflows, package.json scripts, linters, and required checks.",
  "keywords": [
    "ci",
    "holocron",
    "monorepo",
    "task-runner",
    "theholocron",
    "turbo"
  ],
  "homepage": "https://github.com/theholocron/holocron/tree/main/cli/astromech#readme",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "cli/astromech"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs",
      "default": "./dist/config/index.mjs"
    },
    "./lint": {
      "types": "./dist/lint/index.d.mts",
      "import": "./dist/lint/index.mjs",
      "default": "./dist/lint/index.mjs"
    },
    "./release": {
      "types": "./dist/release/index.d.mts",
      "import": "./dist/release/index.mjs",
      "default": "./dist/release/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "delivery.build": "tsdown",
    "sourceQuality.staticAnalysis": "eslint .",
    "test:watch": "vitest",
    "verification.typeSafety": "tsc --noEmit",
    "verification.unitTests": "vitest run"
  },
  "dependencies": {
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@commitlint/types": "catalog:",
    "@theholocron/datapad": "workspace:*",
    "@theholocron/fs-utils": "catalog:utils",
    "@theholocron/json-utils": "catalog:utils",
    "@theholocron/pkg-utils": "catalog:utils"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@theholocron/commitlint-config": "catalog:configs",
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/rollup-plugin-transform-template": "catalog:configs",
    "@theholocron/semantic-release-config": "catalog:configs",
    "@theholocron/tsconfig": "catalog:configs",
    "@theholocron/tsdown-config": "catalog:configs",
    "@theholocron/vitest-config": "catalog:configs",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@semantic-release/commit-analyzer": "^13",
    "@semantic-release/release-notes-generator": "^14",
    "@theholocron/semantic-release-config": ">=8.8.2"
  },
  "peerDependenciesMeta": {
    "@semantic-release/commit-analyzer": {
      "optional": true
    },
    "@semantic-release/release-notes-generator": {
      "optional": true
    },
    "@theholocron/semantic-release-config": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
