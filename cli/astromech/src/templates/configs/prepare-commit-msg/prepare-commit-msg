NAME=$(git config user.name)
EMAIL=$(git config user.email)

if [ -z "$NAME" ]; then
	echo "empty git config user.name"
	exit 1
fi

if [ -z "$EMAIL" ]; then
	echo "empty git config user.email"
	exit 1
fi

git interpret-trailers --if-exists doNothing --trailer \
	"Signed-off-by: $NAME <$EMAIL>" \
	--in-place "$1"

# --config <resolved shared path> (config-resolution workstream, #676) — falls
# back to devmoji's own auto-discovery of a local devmoji.config.cjs when the
# shared package's built dist/ isn't present (not installed, or a stale
# install predating this file).
DEVMOJI_CONFIG="node_modules/@theholocron/devmoji-config/dist/index.cjs"
if [ -f "$DEVMOJI_CONFIG" ]; then
	npx devmoji --config "$DEVMOJI_CONFIG" -e
else
	npx devmoji -e
fi
