{
  "name": "@theholocron/utils-docs",
  "version": "1.2.2",
  "description": "Documentation content for the @theholocron/utils monorepo",
  "keywords": [
    "docs",
    "documentation",
    "content",
    "typescript",
    "utils"
  ],
  "homepage": "https://github.com/theholocron/utils/tree/main/packages/utils-docs#readme",
  "bugs": "https://github.com/theholocron/utils/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/utils.git",
    "directory": "packages/utils-docs"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "content",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@theholocron/tsdown-config": "catalog:configs",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "releases": "https://github.com/theholocron/utils/releases",
  "wiki": "https://github.com/theholocron/utils/wiki"
}
