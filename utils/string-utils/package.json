{
  "name": "@theholocron/string-utils",
  "version": "1.4.2",
  "description": "Convert a string to any case or case to a different data type.",
  "keywords": [
    "string",
    "typescript",
    "utils"
  ],
  "homepage": "https://github.com/theholocron/utils/tree/main/packages/utils-string#readme",
  "bugs": "https://github.com/theholocron/utils/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/utils.git",
    "directory": "packages/string-utils"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
