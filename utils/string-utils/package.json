{
  "name": "@theholocron/string-utils",
  "version": "1.17.0-alpha.1",
  "description": "Convert a string to any case or case to a different data type.",
  "keywords": [
    "string",
    "typescript",
    "utils"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/utils/string-utils/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "utils/string-utils"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:code": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
