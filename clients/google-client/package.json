{
  "name": "@theholocron/google-client",
  "version": "1.58.0-alpha.2",
  "description": "A TypeScript client for Google Workspace APIs (Docs, Sheets)",
  "keywords": [
    "google",
    "workspace",
    "docs",
    "sheets",
    "typescript",
    "api"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/clients/google/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "clients/google-client"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "delivery.build": "tsdown && node ../scripts/check-bundle-size.mjs",
    "sourceQuality.staticAnalysis": "eslint .",
    "test:watch": "vitest",
    "verification.typeSafety": "tsc --noEmit",
    "verification.unitTests": "vitest run"
  },
  "dependencies": {
    "google-auth-library": "catalog:clients",
    "googleapis": "catalog:clients",
    "open": "catalog:clients",
    "server-destroy": "catalog:clients"
  },
  "devDependencies": {
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/server-destroy": "catalog:clients",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
