{
  "name": "@theholocron/http-client",
  "version": "1.57.1-alpha.2",
  "description": "Shared HTTP primitives for theholocron — REST client factory, auth resolver, and error types",
  "keywords": [
    "typescript",
    "http",
    "rest",
    "api",
    "fetch"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/clients/http/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "clients/http-client"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "delivery.build": "tsdown && node ../scripts/check-bundle-size.mjs",
    "sourceQuality.staticAnalysis": "eslint .",
    "test:watch": "vitest",
    "verification.typeSafety": "tsc --noEmit",
    "verification.unitTests": "vitest run"
  },
  "dependencies": {
    "@theholocron/env-utils": "workspace:^",
    "@theholocron/observability": "workspace:^"
  },
  "devDependencies": {
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
