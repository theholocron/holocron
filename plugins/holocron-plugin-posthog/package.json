{
  "name": "@theholocron/holocron-plugin-posthog",
  "version": "5.0.0-alpha.413",
  "description": "Holocron plugin for PostHog. Implements the analytics capability — project provisioning and tracking token retrieval.",
  "keywords": [
    "analytics",
    "holocron",
    "plugin",
    "posthog"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/plugins/posthog/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "plugins/holocron-plugin-posthog"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:code": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:plugin": "tsx scripts/validate.mjs"
  },
  "dependencies": {
    "@theholocron/posthog-client": "workspace:^"
  },
  "devDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/env-utils": "workspace:^",
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/http-client": "workspace:^",
    "@theholocron/misc-utils": "workspace:^",
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "chalk": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/misc-utils": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
