{
  "name": "@theholocron/holocron-plugin-linear",
  "version": "5.0.0-alpha.428",
  "description": "Holocron plugin for Linear. Implements the issues and projects capabilities against the Linear GraphQL API, with export and import for migrating to and from other trackers.",
  "keywords": [
    "holocron",
    "issues",
    "linear",
    "plugin",
    "projects"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/plugins/linear/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "plugins/holocron-plugin-linear"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:code": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/linear-client": "workspace:^",
    "@theholocron/misc-utils": "workspace:^",
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/linear-client": "catalog:peers",
    "@theholocron/misc-utils": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@theholocron/linear-client": {}
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
