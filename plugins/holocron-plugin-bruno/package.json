{
  "name": "@theholocron/holocron-plugin-bruno",
  "version": "5.0.0-alpha.436",
  "description": "Holocron plugin for Bruno. Implements the tooling capability over files: it exports the repo's request collections as OpenCollection YAML.",
  "keywords": [
    "bruno",
    "holocron",
    "plugin",
    "tooling"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/plugins/bruno/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "plugins/holocron-plugin-bruno"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:code": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencollection/converters": "catalog:plugins",
    "@usebruno/converters": "catalog:plugins",
    "js-yaml": "catalog:plugins"
  },
  "devDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@theholocron/cli": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
