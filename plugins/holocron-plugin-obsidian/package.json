{
  "name": "@theholocron/holocron-plugin-obsidian",
  "version": "5.0.0-alpha.433",
  "description": "Holocron plugin for Obsidian. Implements the ideas capability over a vault of Markdown notes.",
  "keywords": [
    "holocron",
    "ideas",
    "obsidian",
    "plugin"
  ],
  "homepage": "https://docs.theholocron.dev/holocron/plugins/obsidian/",
  "bugs": "https://github.com/theholocron/holocron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/holocron.git",
    "directory": "plugins/holocron-plugin-obsidian"
  },
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:code": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@theholocron/astromech": "workspace:^",
    "@theholocron/env-utils": "workspace:^"
  },
  "devDependencies": {
    "@theholocron/cli": "workspace:*",
    "@theholocron/eslint-config": "workspace:^",
    "@theholocron/tsconfig": "workspace:^",
    "@theholocron/tsdown-config": "workspace:^",
    "@theholocron/vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "globals": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@theholocron/cli": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
